# ============================================================================
# .gitignore del repositorio principal
# Los artefactos de compilacion de cada submodulo se ignoran en su propio
# .gitignore. Aqui solo se cubren ficheros locales y temporales de la raiz.
# ============================================================================

# Configuracion local (se copia de config.example.sh)
config.sh
config.local.sh

# Temporales y ficheros de editor / sistema
*.tmp
*.swp
*~
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
venv/

# Posibles productos de compilacion en la raiz
build/
build-*/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
compile_commands.json
.cache/
*.o
*.a
*.so
*.d
*.x
*.exe
*.out
*.gcda
*.gcno
*.profraw
*.profdata
*.dSYM/

# NOTA: resultados/ se versiona a proposito, incluidos sus .json y .log.
